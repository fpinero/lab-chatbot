# Release configuration only. Parsed as data, never sourced as shell code.
KUBE_CONTEXT=orc-k3s
NAMESPACE=labchatbot
DEPLOYMENT=labchatbot
CONTAINER=app
IMAGE_REPO=fpinero/lab-chatbot
PLATFORM=linux/arm64
APP_ORIGIN=https://labchatbot.nivelepsilon.com
# Override with a compatible kubectl executable for this cluster before validation/apply.
KUBECTL=kubectl
KUBECONFORM=kubeconform
IMAGE_PULL_SECRET=
OPENROUTER_KEY_FILE=private/deploy/openrouter.key
OWNER_HASH_FILE=private/deploy/owner.hash
BACKUP_KEY_FILE=private/deploy/backup.key
# Keep false until the origin TLS prerequisite is checked during the staged deployment.
ORIGIN_TLS_VERIFIED=false
# Enable only when preparing a production release from verified main.
RELEASE_READY=false
