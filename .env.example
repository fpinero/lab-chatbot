# Development only. Export values into the process environment.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
PROVIDER_MODE=mock
DATA_DIR=./data
AUTH_MODE=password
AUTH_PASSWORD_HASH_FILE=private/owner.hash
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
TRUSTED_PROXY_NETWORKS=[]
# Live provider values must be explicitly approved and installed privately.
# OPENROUTER_API_KEY_FILE=private/openrouter.key
MAX_REQUEST_USD=0
DAILY_BUDGET_USD=0
LIVE_TEST_BUDGET_USD=0
VISION_REQUEST_ALLOWANCE_USD=0
MODEL_ALLOWLIST=[]
MODEL_PRICE_CEILING_PER_MILLION=10
